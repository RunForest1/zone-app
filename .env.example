# PostgreSQL. В docker compose DATABASE_URL собирается из этих переменных,
# поэтому менять пароль нужно ТОЛЬКО здесь (иначе будет P1000).
# Важно: пароль задаётся базе при первой инициализации тома. Если поменять
# POSTGRES_PASSWORD после первого запуска, старый пароль останется в томе:
# либо смените его в базе, либо пересоздайте том (`docker compose down -v`).
POSTGRES_USER=zone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zone

# Нужен только для запуска вне Docker (например, `bun dev` на хосте):
# в контейнерах DATABASE_URL подставляется из POSTGRES_* выше.
DATABASE_URL=postgresql://zone:change-me@localhost:5432/zone

# API Stalzone: авторизация «по секрету» (см. https://eapi.stalzone.com/auth.html).
CLIENT_ID=
CLIENT_SECRET=

# Домен приложения (ссылки и метаданные).
DOMAIN=http://localhost:3000

# Воркер: период обхода избранных предметов, глубина разового backfill и срок
# хранения (дней). Избранных мало, поэтому обход частый — 2 минуты.
# Историю по остальным подтягивает открытие карточки, но не чаще
# SYNC_ON_DEMAND_MIN_MS. Всё старше WORKER_RETENTION_DAYS удаляется.
WORKER_INTERVAL_MS=120000
WORKER_BACKFILL_DAYS=30
WORKER_RETENTION_DAYS=35

# Как часто при открытии карточки можно подтягивать историю, мс.
SYNC_ON_DEMAND_MIN_MS=120000

# Второй, независимый цикл воркера: скан активных лотов по избранному (мс).
LOT_SCAN_INTERVAL_MS=1800000

# Минимум сделок в срезе (качество+точка) за 7 дней, иначе лот пропускаем.
SCAN_MIN_SALES=3

# --- Телеграм-бот уведомлений (сервис bot) ---
# Токен бота выдаёт @BotFather при создании бота (вид: 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Прокси для запросов к api.telegram.org. Указывается ИМЯ КОНТЕЙНЕРА общего
# стека shared-proxy (не имя сервиса!) и порт 1081 — это http-inbound Xray.
# Именно http, а не socks5: встроенный fetch Bun не умеет socks-прокси.
# Если бот работает из сети без блокировок (зарубежный VPS) — оставьте пустым.
TELEGRAM_PROXY_URL=http://shared-proxy:1081

# Кому разрешено менять фильтры командами (/filter, /pause, /resume).
# Это Telegram user.id через запятую (именно user.id, не chat.id!). Свой id
# можно узнать у бота @userinfobot. Пусто = менять настройки не может никто.
ALERT_ADMIN_USER_IDS=

# Как часто бот проверяет очередь уведомлений, мс (по умолчанию 10000).
BOT_POLL_MS=10000
