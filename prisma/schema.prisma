// Схема БД: сделки, отслеживаемые предметы, состояние и лог синхронизации,
// а также подписки телеграм-бота и лог его уведомлений.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Предмет, по которому храним историю сделок (появляется при открытии карточки
// или добавлении в избранное).
model TrackedItem {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Избранное: помечено вручную (веб/бот). Воркер синкает только избранные.
  favorite Boolean @default(false)

  sales Sale[]
  sync  ItemSync?
}

// Состояние синхронизации предмета.
model ItemSync {
  itemId String      @id
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Когда сделан разовый backfill истории.
  backfilledAt DateTime?
  // Когда последний раз успешно синхронизировали.
  lastSyncedAt DateTime?
  // Время самой свежей сделки в базе (с него продолжаем дописывание).
  lastSaleTime DateTime?
  // Текст последней ошибки (если была).
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Совершённая сделка.
model Sale {
  id     BigInt      @id @default(autoincrement())
  itemId String
  item   TrackedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  time   DateTime
  price  BigInt
  amount Int      @default(1)
  // Качество и точка предмета (у части предметов их нет).
  quality Int?
  point   Int?

  // Ключ дедупликации: одинаковые сделки из API не задваиваются.
  key String @unique

  createdAt DateTime @default(now())

  // По (itemId, time) читаем период предмета, по time — чистим старое.
  @@index([itemId, time])
  @@index([time])
}

// Журнал синхронизаций (по предмету и по всему прогону воркера).
model SyncLog {
  id     BigInt  @id @default(autoincrement())
  itemId String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // ok | error
  status String
  // Сколько сделок добавлено.
  added Int     @default(0)
  // Сообщение об ошибке или пояснение.
  message String?

  @@index([startedAt])
}

// Чат (обычно один групповой), куда бот шлёт уведомления, со своими фильтрами.
model AlertChat {
  id             String @id @default(cuid())
  // chat.id из Telegram (отрицательный для групп) храним строкой.
  telegramChatId String @unique
  // Название чата — для логов и отладки.
  title String?

  // Порог прибыли в игровой валюте (деньги храним BigInt, как в Sale.price).
  minProfit BigInt @default(50000)
  // Порог маржи в % (необязательный).
  minMargin Float?
  // Пусто = все категории (верхний уровень CATEGORY_TREE) / все ранги.
  categories String[] @default([])
  ranks      String[] @default([])

  // Фильтры по качеству (qlt 0–5) и точке (ptn 0–15) — наборы значений.
  // Пусто = без ограничения (для артефактов это полный диапазон).
  qualities Int[] @default([])
  points    Int[] @default([])

  // /pause выключает без удаления настроек.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AlertEvent[]
}

// Уведомление о выгодной сделке: строка-очередь и лог отправки одновременно.
// sentAt = null — событие ещё не отправлено (его берёт процесс bot).
model AlertEvent {
  id          String    @id @default(cuid())
  alertChatId String
  alertChat   AlertChat @relation(fields: [alertChatId], references: [id], onDelete: Cascade)

  // id предмета (как в ItemsDatabase) и ключ сделки из Sale.key.
  itemId  String
  saleKey String

  // Прибыль и маржа, посчитанные детектором воркера.
  profit BigInt
  margin Float?

  // Цена последней сделки по тому же качеству/точке и рынок за периоды:
  // массив { days, average, median, deals } (7/14/30 дней).
  lastPrice BigInt?
  stats     Json?

  // Когда уведомление отправлено (null — в очереди).
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  // Одна и та же сделка не шлётся чату дважды.
  @@unique([alertChatId, saleKey])
  @@index([itemId])
  @@index([sentAt])
}
